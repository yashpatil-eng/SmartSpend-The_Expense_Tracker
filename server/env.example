# ========================================
# SERVER ENVIRONMENT VARIABLES
# ========================================

# Server Configuration
PORT=5000

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/smartspend

# JWT Configuration
JWT_SECRET=replace_with_super_secure_secret

# Frontend URLs (for CORS)
# Add all frontend URLs here that need access to the API
# Local: http://localhost:5173, http://localhost:5174
# Production: https://smart-spend-the-expense-tracker.vercel.app
CLIENT_URL=http://localhost:5173

# Google OAuth Configuration
# Get this from: https://console.cloud.google.com
# Create OAuth 2.0 credentials (Web Application)
# The credential you get from frontend will be verified against this CLIENT_ID
GOOGLE_CLIENT_ID=your_google_web_client_id

# OTP Configuration
OTP_TTL_MS=300000

# Twilio Configuration (for SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number