# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================

# Backend API URL
# IMPORTANT: Must include /api suffix
# Local: http://localhost:5000/api
# Production: https://smartspend-backend-oobd.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Configuration
# Get this from: https://console.cloud.google.com
# Create OAuth 2.0 credentials (Web Application)
# Add authorized JavaScript origins: http://localhost:5173, https://smart-spend-the-expense-tracker.vercel.app
# Add authorized redirect URIs: http://localhost:5173, https://smart-spend-the-expense-tracker.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id